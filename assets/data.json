{
  "calculators": [
    {
      "id": "temp-cf",
      "title": "Temperature °C↔°F",
      "inputs": ["value", "unit"],
      "outputs": ["convertedValue", "convertedUnit"],
      "equation": "C = 0.56 × (F – 32); F = (1.8 × C) + 32",
      "units": "°C, °F",
      "notes": "Use linear formulas; show both.",
      "sourcePage": "i3"
    },
    {
      "id": "hp-torque",
      "title": "HP ↔ Torque",
      "inputs": ["rpm", "hp OR torque"],
      "outputs": ["hp OR torque"],
      "equation": "hp = (Torque(in-lb) × rpm) / 63025; Torque(in-lb) = (63025 × hp)/rpm",
      "units": "hp, in-lb, rpm",
      "notes": "Also show ft-lb version with 5252.",
      "sourcePage": "i5–i6"
    },
    {
      "id": "pump-hp",
      "title": "Pump HP",
      "inputs": ["GPM", "psi", "efficiency"],
      "outputs": ["hp"],
      "equation": "hp = (GPM × psi) / (1714 × efficiency)",
      "units": "GPM, psi, hp, efficiency",
      "notes": "Default efficiency 0.85; editable.",
      "sourcePage": "i5–i6"
    },
    {
      "id": "cv-helper",
      "title": "Valve Cv Helper",
      "inputs": ["flowRate", "pressureDrop", "specificGravity"],
      "outputs": ["cv"],
      "equation": "Cv = Q × sqrt(SG / ΔP)",
      "units": "GPM, psi, Cv",
      "notes": "Downstream pressure should be ~53% of upstream for best control. This is the 53% rule.",
      "sourcePage": "i7"
    }
  ],
