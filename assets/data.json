  "glossary": [
    {
      "term": "Horsepower",
      "definition": "Rate of doing work; 33,000 lb-ft/min. One horsepower equals 550 ft-lb/s or 746 watts.",
      "sourcePage": "i5",
      "relatedTerms": ["Torque", "Work", "Power"]
    },
    {
      "term": "Torque",
      "definition": "Turning moment; force × radius. Measured in lb-ft or lb-in. Creates rotational motion.",
      "sourcePage": "i5–i6",
      "relatedTerms": ["Horsepower", "Force"]
    },
    {
      "term": "Cv (Flow Coefficient)",
      "definition": "Valve flow coefficient. GPM of water at 60°F with 1 psi pressure drop. Used to size control valves.",
      "sourcePage": "i7",
      "relatedTerms": ["Flow Rate", "Pressure Drop"]
    },
    {
      "term": "GPM",
      "definition": "Gallons Per Minute. Common flow rate measurement for hydraulic and process systems.",
      "sourcePage": "i4",
      "relatedTerms": ["Flow Rate", "Cv"]
    },
    {
      "term": "Specific Gravity",
      "definition": "Ratio of fluid density to water density. Water = 1.0. Used in flow calculations.",
      "sourcePage": "i7",
      "relatedTerms": ["Density", "Cv"]
    },
    {
      "term": "Efficiency",
      "definition": "Ratio of output power to input power. Expressed as decimal (0.85) or percentage (85%). Accounts for losses.",
      "sourcePage": "i5–i6",
      "relatedTerms": ["Horsepower", "Power"]
    },
    {
      "term": "Pressure Drop",
      "definition": "Difference in pressure between two points in a system. Critical for sizing valves and pipes. Measured in psi or bar.",
      "sourcePage": "i7",
      "relatedTerms": ["Cv", "Pressure"]
    }
  ]
}
